# AI Q&A providers for /api/ask. Both are optional — without either key,
# /api/ask still works but returns a canned answer built from the raw
# quote/chart data instead of an AI-generated response.
#
# If both are set, Gemini is tried first (falling back to Anthropic on
# failure), since Gemini has a generous free tier.

# Google Gemini (recommended, free tier, no credit card required):
# get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude (paid, usage-based): get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: protects /api/cron/daily-brief (the Vercel Cron trigger that
# pre-warms the daily brief). Vercel sends this automatically as
# `Authorization: Bearer <secret>` when set; if you don't set it, the route
# is unauthenticated (harmless — a manual hit just regenerates the brief
# early).
CRON_SECRET=
